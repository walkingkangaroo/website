---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="There's nothing at this address." noindex>
  <div class="container page">
    <h1>Page not found</h1>
    <p>There's nothing at this address.</p>
    <a class="home" href="/">Back to the home page</a>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  h1 {
    margin-bottom: 0.6em;
  }

  .home {
    display: inline-block;
    padding: 14px 22px;
    border-radius: 999px;
    background: var(--wk-ink);
    color: var(--wk-paper);
    font-weight: 600;
    text-decoration: none;
  }

  .home:hover {
    background: var(--wk-rust);
    color: var(--wk-paper);
  }
</style>
