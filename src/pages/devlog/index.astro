---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
---

{/* The description is a draft for Grant to check in the pull request. */}
<BaseLayout title="Devlog" description="Notes on how Grant's games and apps are coming along.">
  <div class="container page">
    <h1>Devlog</h1>
    {
      posts.length > 0 ? (
        <div class="posts">
          {posts.map((post) => (
            <PostCard post={post} headingLevel="h2" />
          ))}
        </div>
      ) : (
        <p class="empty">No posts yet.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  h1 {
    margin-bottom: 0.6em;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 32px;
  }

  .empty {
    margin: 0;
    color: var(--site-text-quiet);
  }
</style>
