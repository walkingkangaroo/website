---
import MediaPanel from './MediaPanel.astro';
import StageMeter from './StageMeter.astro';
import type { Project } from '../lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, type, oneLiner, stage, platforms, cover } = project.data;
---

<a class="card" href={`/projects/${project.id}/`}>
  {/* The name sits right below, so the cover needs no alt text of its own. */}
  <MediaPanel image={cover} aspect="3 / 4" alt="" radius="16px" sizes="(min-width: 600px) 280px, 100vw" />
  <span class="type">{type}</span>
  <h3 class="name">{name}</h3>
  <span class="one-liner">{oneLiner}</span>
  <StageMeter stage={stage} size="sm" label="short" detail={platforms.length ? platforms.join(', ') : undefined} />
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    color: var(--wk-ink);
    text-decoration: none;
  }

  .card:hover {
    color: var(--wk-ink);
  }

  .card:hover .name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .type {
    padding-top: 4px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wk-rust);
  }

  .name {
    margin: -6px 0 0;
    font-size: 22px;
    line-height: 1.2;
  }

  .one-liner {
    font-size: 15px;
    color: var(--site-text-quiet);
  }
</style>
