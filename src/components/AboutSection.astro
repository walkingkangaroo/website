---
import { site } from '../data/site';

interface Props {
  /** The page's only h1 on /about/; the home page keeps the default h2. */
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel: Heading = 'h2' } = Astro.props;
const { bio, links } = site;
---

<section id="about" class="about">
  <div class="container about__inner">
    <div class="about__text">
      <Heading class="about__title">Hi, I'm Grant.</Heading>
      {bio && <p class="bio">{bio}</p>}
      {
        links.length > 0 && (
          <ul class="links">
            {
              links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--site-rule);
  }

  .about__inner {
    padding-block: clamp(56px, 8vw, 96px);
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about__title {
    margin: 0;
    font-size: clamp(28px, 5vw, 36px);
    /* Global h1 adds tracking at 48 px and up; keep the h1 identical to the h2. */
    letter-spacing: normal;
  }

  .bio {
    margin: 0;
    max-width: 680px;
    font-size: 20px;
    color: var(--site-text-quiet);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }
</style>
