---
import logo from '../assets/brand/walking-kangaroo-logo-horizontal-primary.svg';

// The year is the year of the build, so the notice updates itself on each deploy.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <img src={logo.src} width="136" height="20" alt="Walking Kangaroo" />
    <p>© {year} Walking Kangaroo · walkingkangaroo.com</p>
  </div>
</footer>

<style>
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 32px;
    padding-bottom: 48px;
    font-size: 15px;
    color: var(--site-text-quiet);
  }

  .site-footer__inner img {
    display: block;
    height: 20px;
    width: auto;
  }

  .site-footer__inner p {
    margin: 0;
  }
</style>
