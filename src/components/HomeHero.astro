---
import MediaPanel from './MediaPanel.astro';
import StageMeter from './StageMeter.astro';
import type { Project } from '../lib/content';
import markRust from '../assets/brand/walking-kangaroo-mark-rust.svg';

interface Props {
  /** The featured project. */
  project: Project;
}

const { project } = Astro.props;
const { name, oneLiner, stage, platforms, clip, cover } = project.data;

const eyebrow = platforms.length ? `In development · ${platforms.join(' / ')}` : 'In development';
const hasClip = Boolean(clip);

// The footprint trail steps up and to the right. The offsets are in pixels, measured on the board's
// 234 x 279 box, and are turned into percentages of that box so the whole trail scales with it.
const TRAIL_W = 234;
const TRAIL_H = 279;
const PRINT_W = 70;
const trail = [
  { right: 164, top: 228, opacity: 0.15 },
  { right: 94, top: 133, opacity: 0.3 },
  { right: 42, top: 60, opacity: 0.55 },
  { right: 0, top: 0, opacity: 0.85 },
].map((step) => ({
  right: `${((step.right / TRAIL_W) * 100).toFixed(2)}%`,
  top: `${((step.top / TRAIL_H) * 100).toFixed(2)}%`,
  opacity: step.opacity,
}));
const printWidth = `${((PRINT_W / TRAIL_W) * 100).toFixed(2)}%`;
---

<section id="top" class="container hero-section">
  <div class="hero">
    <div class="hero__stage">
      <MediaPanel
        image={cover}
        clip={clip}
        poster={cover}
        alt=""
        aspect="16 / 9"
        radius="24px"
        sizes="(min-width: 1280px) 798px, (min-width: 1024px) calc((100vw - 120px) * 0.6875), calc(100vw - 2 * clamp(16px, 4vw, 40px))"
      />
      <div class="trail" aria-hidden="true">
        {
          trail.map((step) => (
            <img
              class="trail__print"
              src={markRust.src}
              width={markRust.width}
              height={markRust.height}
              alt=""
              style={{ right: step.right, top: step.top, width: printWidth, opacity: step.opacity }}
            />
          ))
        }
      </div>
    </div>

    <div class="hero__text">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{name}</h1>
      <p class="one-liner">{oneLiner}</p>
      <StageMeter stage={stage} size="md" label="long" detail={platforms.length ? platforms.join(', ') : undefined} />
      <div class="actions">
        <a class="btn btn--solid" href="/#news">Follow development</a>
        {
          hasClip ? (
            <a class="btn btn--outline" href={`/projects/${project.id}/`}>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 2.5v11l9-5.5z" />
              </svg>
              Watch the prototype
            </a>
          ) : (
            <a class="btn btn--outline" href={`/projects/${project.id}/`}>
              See the project
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 16px;
  }

  /* Phones and tablets: the 16:9 image sits above the text, both the full width of the page. */
  .hero {
    display: block;
  }

  /* The image panel is 16:9 and never cropped. It is the container the trail sizes itself from
     (cqw). */
  .hero__stage {
    position: relative;
    container-type: inline-size;
  }

  /* The trail sits inside the image's top right corner, 4% of the panel's width in from the top
     and right edges. Its width is 16% of the panel's width, held between 90 px and 130 px, so it is
     90 px at 390 px wide (the panel is 358 px), about 118 px at 800 px wide (736 px panel, a
     little less with a scrollbar) and 128 px at 1440 px wide (798 px panel). Its prints are sized
     and placed as percentages of this box. */
  .trail {
    position: absolute;
    right: 4cqw;
    top: 4cqw;
    width: clamp(90px, 16cqw, 130px);
    aspect-ratio: 234 / 279;
    pointer-events: none;
  }

  .trail__print {
    position: absolute;
    height: auto;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-top: 24px;
  }

  .eyebrow {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wk-rust);
  }

  h1 {
    margin: 0;
    font-size: clamp(44px, 6vw, 80px);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  /* Tracking of -2.5% once the heading is 48 px or more (6vw reaches 48 px at 800 px wide). */
  @media (min-width: 800px) {
    h1 {
      letter-spacing: -0.025em;
    }
  }

  .one-liner {
    margin: 0;
    font-size: 20px;
    color: var(--site-text-quiet);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 44px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }

  .btn--solid {
    padding: 14px 22px;
    background: var(--wk-ink);
    color: var(--wk-paper);
  }

  .btn--solid:hover {
    background: var(--wk-rust);
    color: var(--wk-paper);
  }

  .btn--outline {
    padding: 12px 20px;
    border: 2px solid var(--wk-ink);
    color: var(--wk-ink);
  }

  .btn--outline:hover {
    background: var(--wk-ink);
    color: var(--wk-paper);
  }

  /* Phones: the buttons span the full width. */
  @media (max-width: 719px) {
    .actions {
      width: 100%;
    }
  }

  /* Desktop: a split hero, text on the left and the image on the right, side by side with no
     overlap and no box behind the text. The columns are 1fr and 2.2fr with a 40 px gap, so at
     1440 px wide (a 1200 px content box) the text is 362 px and the image 798 px wide by 449 px
     tall, which is the hero's height; at 1024 px wide the text column is about 280 px and the
     image about 610 px by 345 px. Both columns are centred on the row, and the image is never
     stretched or cropped: where the text is taller than the image (at 1024 px wide the text makes
     the hero about 513 px tall) the row grows to the text and the image stays whole, centred in
     it. */
  @media (min-width: 1024px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
      column-gap: 40px;
      align-items: center;
    }

    .hero__stage {
      grid-column: 2;
      grid-row: 1;
    }

    .hero__text {
      grid-column: 1;
      grid-row: 1;
      padding-top: 0;
    }

    /* The column is narrow, so the heading is a fixed 48 px (the tracking rule above applies). */
    h1 {
      font-size: 48px;
    }
  }
</style>
