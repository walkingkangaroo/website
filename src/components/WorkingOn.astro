---
interface Props {
  /** What is being worked on now, one short line each. Renders nothing when empty. */
  items?: string[];
}

const { items = [] } = Astro.props;
---

{
  items.length > 0 && (
    <div class="panel">
      <h2>Working on now</h2>
      <ul>
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    background: var(--site-panel);
    border-radius: 20px;
  }

  h2 {
    margin: 0;
    font-size: 20px;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding-left: 20px;
  }
</style>
