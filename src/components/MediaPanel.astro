---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** A cover or screenshot from src/. Shown when there is no clip. */
  image?: ImageMetadata;
  /** Path to a video under public/, for example /clips/common-ground.mp4. */
  clip?: string;
  /** Still shown before the clip plays: an image from src/ or a path under public/. */
  poster?: ImageMetadata | string;
  /** CSS aspect-ratio, for example "3 / 4" or "16 / 9". Ignored when `fill` is set. */
  aspect?: string;
  /** Alt text for the image. Use "" when the text beside it already says what it shows. */
  alt: string;
  /** CSS border-radius, for example "16px". */
  radius?: string;
  /** Show the video's own controls (the project page). */
  controls?: boolean;
  /** Fill the parent (which must be positioned) instead of keeping `aspect`. The hero uses this. */
  fill?: boolean;
  /** The image's `sizes` attribute: how wide the panel is in the layout. Defaults to the viewport. */
  sizes?: string;
}

const { image, clip, poster, aspect = '16 / 9', alt, radius = '0', controls = false, fill = false, sizes = '100vw' } = Astro.props;
// The video type from the file extension; left out when it is not one we know.
const clipType = clip ? { mp4: 'video/mp4', webm: 'video/webm' }[clip.split('.').pop()?.toLowerCase() ?? ''] : undefined;
const posterSrc = typeof poster === 'string' ? poster : poster?.src;
---

<div class:list={['media-panel', { 'media-panel--fill': fill }]} style={{ '--aspect': aspect, '--radius': radius }}>
  {
    clip ? (
      <video
        class="media"
        poster={posterSrc}
        muted
        loop
        playsinline
        autoplay
        preload="metadata"
        controls={controls}
        aria-hidden={controls ? undefined : 'true'}
      >
        {/* The source only matches when motion is welcome, so a visitor who prefers reduced motion sees just the poster (no script needed, decision 0013). */}
        <source src={clip} type={clipType} media="(prefers-reduced-motion: no-preference)" />
      </video>
    ) : image ? (
      <Image class="media" src={image} alt={alt} widths={[480, 800, 1200, 1800]} sizes={sizes} />
    ) : null
  }
</div>

<style>
  .media-panel {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--aspect);
    border-radius: var(--radius);
    background: var(--site-media);
  }

  .media-panel--fill {
    position: absolute;
    inset: 0;
    width: auto;
    aspect-ratio: auto;
  }

  .media-panel :global(.media) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
