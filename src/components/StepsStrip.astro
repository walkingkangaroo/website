---
import footprint from '../assets/footprint.svg';

// The meaning of each step. The names come from the same list as the stage meter.
const steps = [
  { name: 'Idea', meaning: 'On paper' },
  { name: 'Prototype', meaning: 'Playable core' },
  { name: 'Alpha', meaning: 'All features in' },
  { name: 'Beta', meaning: 'Polish and testing' },
  { name: 'Launch', meaning: 'Out in the world' },
];
---

<section class="container steps-section" aria-label="How projects progress">
  <div class="steps-panel">
    <div class="intro">
      <h2>Five steps to launch</h2>
      <p>Every game walks the same path. The filled prints show how far each one has come.</p>
    </div>
    <ol class="steps">
      {
        steps.map((step) => (
          <li class="step">
            <img src={footprint.src} width="32" height="38" alt="" />
            <span class="step__name">{step.name}</span>
            <span class="step__meaning">{step.meaning}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps-section {
    padding-bottom: clamp(40px, 6vw, 64px);
  }

  .steps-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px 56px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 24px;
    background: var(--site-panel);
  }

  .intro {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .intro h2 {
    margin: 0;
    font-size: 28px;
  }

  .intro p {
    margin: 0;
    color: var(--site-text-quiet);
  }

  .steps {
    flex: 2 1 520px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 88px;
    text-align: center;
  }

  .step img {
    display: block;
    width: 32px;
    height: 38px;
  }

  /* The first, third and fifth prints stand 12 px higher, so the row steps like a trail. */
  .step:nth-child(odd) img {
    margin-bottom: 12px;
  }

  .step__name {
    font-size: 15px;
    font-weight: 600;
  }

  .step__meaning {
    margin-top: -6px;
    font-size: 13px;
    line-height: 1.3;
    color: var(--site-text-quiet);
  }

  @media (max-width: 719px) {
    .steps {
      gap: 8px 16px;
    }
  }
</style>
